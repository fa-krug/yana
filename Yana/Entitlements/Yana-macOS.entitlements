<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Sandbox is required for a Mac App Store build; network.client lets the
	     sandboxed app reach the user's self-hosted Yana Server. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Identical to the iOS target's group: that is what shares the device token
	     Keychain item across the two platform builds. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)de.fa-krug.Yana</string>
	</array>
</dict>
</plist>
