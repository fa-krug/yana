<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The macOS target has its own entitlements file (Yana-macOS.entitlements) carrying
	     the App Sandbox / network keys. This group is identical in both files on purpose:
	     that is what keeps the device token Keychain item shared across platforms. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)de.fa-krug.Yana</string>
	</array>
</dict>
</plist>
