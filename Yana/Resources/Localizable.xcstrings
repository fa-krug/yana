    "Server mode uses whatever AI provider you've configured on the server. Apple Intelligence runs entirely on this device.": {
      "comment": "Footer explaining the two AI mode options in Settings.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Servermodus verwendet den auf dem Server konfigurierten KI-Anbieter. Apple Intelligence läuft vollständig auf diesem Gerät."
          }
        }
      }
    },
    "Your own private feed reader — all your sources, gathered on your server.": {
      "comment": "Subtitle on the welcome onboarding page.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein eigener privater Feed-Reader – alle deine Quellen, gesammelt auf deinem Server."
          }
        }
      }
    },
    "Your Own Server": {
      "comment": "Feature title on the welcome onboarding page.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein eigener Server"
          }
        }
      }
    },
    "Yana pairs with a Yana Server you control, which aggregates your feeds and syncs them to every device.": {
      "comment": "Feature detail on the welcome onboarding page.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Yana verbindet sich mit einem Yana-Server, den du selbst kontrollierst und der deine Feeds sammelt und mit allen Geräten synchronisiert."
          }
        }
      }
    },
    "Summarize, improve, or translate articles — via your server's AI provider, or entirely on-device with Apple Intelligence.": {
      "comment": "Feature detail on the welcome onboarding page.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fasse Artikel zusammen, verbessere oder übersetze sie – über den KI-Anbieter deines Servers oder vollständig auf dem Gerät mit Apple Intelligence."
          }
        }
      }
    },
    "Server Address": {
      "comment": "Section header for the server-URL field on the onboarding server-pairing step.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveradresse"
          }
        }
      }
    },
