    "Delete “%@”? Its %lld articles will be permanently deleted.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ löschen? Die zugehörigen %2$lld Artikel werden endgültig gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete “%1$@”? Its %#@articleCount@ will be permanently deleted."
          },
          "substitutions": {
            "articleCount": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg article"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg articles"
                    }
                  }
                }
              }
            }
